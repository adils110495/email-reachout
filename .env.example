APP_NAME="AI Client Finder"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# One timezone for the whole app: stored times, the scheduler, every date in the UI and the
# MySQL session all follow it. Changing it later is safe (dates are stored as absolute instants).
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cold_email_db
DB_USERNAME=sail
DB_PASSWORD=password

# Cache & Session
CACHE_STORE=redis
SESSION_DRIVER=file
# Behind a load balancer / Cloudflare: "*" or the proxy IPs, so client IPs and HTTPS are seen correctly.
#TRUSTED_PROXIES=*
SESSION_LIFETIME=120

# Queue
QUEUE_CONNECTION=redis
QUEUE_RETRY_AFTER=180

# Mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="outreach@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# SerpAPI — Google Search API (100 free searches/month)
# Sign up & get key at: https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Outreach settings
SENDER_NAME="Your Name"
SENDER_COMPANY="Your Company"
EMAIL_DELAY_MIN=30
EMAIL_DELAY_MAX=60

# IMAP — copy sent emails to Sent folder

IMAP_HOST=imap.example.com
IMAP_USERNAME=your_imap_username
IMAP_PASSWORD=your_imap_password
IMAP_FROM_FOLDER=INBOX
IMAP_FOLDER=INBOX.Sent
IMAP_PORT=993
IMAP_PROTOCOL=ssl

# Docker ports
APP_PORT=8080
DB_PORT_EXTERNAL=3306
PMA_PORT=8081

# Email verification (Verifier / Bulks modules)
#
# VERIFY_SMTP_PROBE opens a real SMTP conversation with the recipient's mail
# server to confirm the mailbox exists. It needs outbound port 25, which most
# hosts block - leave it false there, or every result comes back "unknown".
VERIFY_SMTP_PROBE=false
VERIFY_SMTP_TIMEOUT=8
# The address the probe identifies itself with. Use a domain you control.
VERIFY_SMTP_FROM="${MAIL_FROM_ADDRESS}"
# How long a domain's DNS answer is reused, in seconds.
VERIFY_CACHE_TTL=86400
# Hard ceiling on rows accepted from one CSV upload.
VERIFY_BULK_MAX_ROWS=5000

# ──────────────────────────────────────────────────────────────
# Redis (sequencer queue, rate limiting, atomic counters, locks)
# ──────────────────────────────────────────────────────────────
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

# ──────────────────────────────────────────────────────────────
# Mail Sequencer
# ──────────────────────────────────────────────────────────────
SEQUENCER_DEFAULT_DAILY_LIMIT=100
SEQUENCER_DEFAULT_RATE_PER_MINUTE=10
# How many days of inbox history to scan the first time an account is polled.
SEQUENCER_IMAP_LOOKBACK_DAYS=14
SEQUENCER_IMAP_MAX_PER_RUN=200
SEQUENCER_SMTP_TIMEOUT=30
# Public base URL used in tracking and unsubscribe links (defaults to APP_URL).
SEQUENCER_PUBLIC_URL=
# Postal address shown in every email footer (CAN-SPAM). Leave blank to omit.
SEQUENCER_FOOTER_ADDRESS=
# Allow SMTP/IMAP hosts on private networks in Mail Settings. Defaults to true only in
# local/testing; keep false in production (stops "Test connection" probing internal hosts).
#SEQUENCER_ALLOW_PRIVATE_HOSTS=false
# Validate IMAP TLS certificates. Set false only for a self-signed development mail server.
IMAP_VALIDATE_CERT=true
